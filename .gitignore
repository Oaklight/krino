.env
__pycache__/
*.pyc
.venv/
site/
.claude/
model/docs/gpu-inventory.md
data/benchmarks/synthetic/synthetic.jsonl
data/benchmarks/synthetic/.hf_manifest.json
# Derived, not source: the cluster cache is keyed by CACHE_VERSION plus a
# content fingerprint, so a committed copy goes stale the moment either moves
# and the loader recomputes anyway.  Tracking it also means every test run
# rewrites a tracked file.
data/benchmarks/synthetic/.split_clusters.json

# Materialised benchmark corpora: hundreds of megabytes, rebuilt on demand by
# `python -m data.pipeline <source>`.  The authored eval sets stay tracked: they
# are small, and a held-out set that moves with a rebuild is not held out.
data/benchmarks/*.jsonl
!data/benchmarks/openjev/authored144.jsonl
!data/benchmarks/openjev/authored_holdout.jsonl


# Web dashboard
web/node_modules/
web/.next/
web/out/
web/screenshots/
